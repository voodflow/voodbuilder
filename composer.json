{
    "name": "voodflow/voodbuilder",
    "description": "VoodBuilder — commercial Filament plugin for public site themes, site pages, and GrapesJS page builder on Laravel.",
    "version": "0.0.11",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "filament",
        "voodbuilder",
        "theme",
        "page-builder",
        "voodflow"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "jeffersongoncalves/filament-cookie-consent": "^3.2",
        "ralphjsmit/laravel-seo": "^1.8",
        "solution-forest/filament-nestable-tree": "^1.0",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-settings": "^3.0|^4.0",
        "spatie/laravel-sluggable": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Voodflow\\Voodbuilder\\": "src/",
            "Voodflow\\Voodbuilder\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voodflow\\Voodbuilder\\Tests\\": "tests/",
            "Voodflow\\Vtuts\\": "../vtuts/src/",
            "Voodflow\\VoodbuilderPopups\\": "../voodbuilder-popups/src/",
            "Voodflow\\Voodbuilder\\Modules\\Popups\\": "../voodbuilder-popups/src/Modules/Popups/",
            "Voodflow\\Voodbuilder\\Support\\GrapesJs\\Popups\\": "../voodbuilder-popups/src/Support/GrapesJs/Popups/",
            "Voodflow\\Voodbuilder\\Filament\\Resources\\PopupResource\\": "../voodbuilder-popups/src/Filament/Resources/PopupResource/"
        },
        "classmap": [
            "../voodbuilder-popups/src/Models/",
            "../voodbuilder-popups/src/Enums/",
            "../voodbuilder-popups/src/Http/Controllers/",
            "../voodbuilder-popups/src/Filament/Resources/PopupResource.php",
            "../voodbuilder-popups/src/Filament/Actions/",
            "../voodbuilder-popups/src/Support/GrapesJs/GrapesJsPopupEditorGate.php"
        ]
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-markdown": "^2.7"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voodflow\\Voodbuilder\\VoodbuilderServiceProvider"
            ]
        },
        "suggest": {
            "voodflow/voodbuilder-popups": "FilamentPHP 5 plugin: popup builder, runtime and analytics for VoodBuilder."
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
