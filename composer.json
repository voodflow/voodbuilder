{
    "name": "voodflow/voodbuilder",
    "description": "VoodBuilder — commercial Filament plugin for public site themes, site pages, and GrapesJS page builder on Laravel.",
    "version": "0.0.10",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "filament",
        "voodbuilder",
        "theme",
        "page-builder",
        "voodflow"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "jeffersongoncalves/filament-cookie-consent": "^3.2",
        "ralphjsmit/laravel-seo": "^1.8",
        "solution-forest/filament-nestable-tree": "^1.0",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-settings": "^3.0|^4.0",
        "spatie/laravel-sluggable": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Voodflow\\Voodbuilder\\": "src/",
            "Voodflow\\Voodbuilder\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voodflow\\Voodbuilder\\Tests\\": "tests/",
            "Voodflow\\Vtuts\\": "../vtuts/src/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voodflow\\Voodbuilder\\VoodbuilderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
