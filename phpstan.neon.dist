includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    tmpDir: build/phpstan
    # Baseline is generated on a standalone checkout (CI). In the monorepo the private
    # siblings resolve, so some class.notFound entries legitimately do not match.
    reportUnmatchedIgnoredErrors: false
