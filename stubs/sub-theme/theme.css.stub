/**
 * {{ name }} sub-theme — layout shell for Site Pages.
 * Colors can be set in Admin → Settings → Layouts without editing this file.
 *
 * Standalone Vite entry: reference main theme tokens for @apply utilities.
 * Vendor installs: use ../../../../vendor/voodflow/voodbuilder/resources/css/theme.css
 */

@reference "../../../../packages/voodflow/voodbuilder/resources/css/theme.css";

html[data-voodbuilder-sub-theme='{{ id }}'] {
    --width-vp-content: 43rem;
    --width-vp-layout: 90rem;
}

html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content {
    @apply mx-auto w-full max-w-[var(--width-vp-layout)] px-6 md:px-8;
}

html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content:not(:has(.VPRichPage--landing)):not(:has(.voodbuilder-grapesjs-frontend)) {
    @apply py-12 md:py-24;
}
