/**
 * {{ name }} sub-theme — layout shell for Site Pages.
 * Colors: Admin → Theme Studio (instant, no build).
 *
 * Plain CSS only — served at runtime via ThemePalette (not a Vite entry).
 * Prefer CSS variables and var(--color-vp-*) over Tailwind @apply.
 */

html[data-voodbuilder-sub-theme='{{ id }}'] {
    --width-vp-content: 43rem;
    --width-vp-layout: 90rem;
}

html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content {
    margin-inline: auto;
    width: 100%;
    max-width: var(--width-vp-layout);
    padding-inline: 1.5rem;
}

@media (min-width: 768px) {
    html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content {
        padding-inline: 2rem;
    }
}

html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content:not(:has(.VPRichPage--landing)):not(:has(.voodbuilder-editor-frontend)) {
    padding-block: 3rem;
}

@media (min-width: 768px) {
    html[data-voodbuilder-sub-theme='{{ id }}'] .voodbuilder-{{ id }}-content:not(:has(.VPRichPage--landing)):not(:has(.voodbuilder-editor-frontend)) {
        padding-block: 6rem;
    }
}
