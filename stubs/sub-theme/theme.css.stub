/**
 * {{ name }} sub-theme — layout shell for Site Pages.
 * Colors can be set in Admin → Settings → Layouts without editing this file.
 */

html[data-vpress-sub-theme='{{ id }}'] {
    --width-vp-content: 43rem;
    --width-vp-layout: 90rem;
}

html[data-vpress-sub-theme='{{ id }}'] .vpress-{{ id }}-content {
    @apply mx-auto w-full max-w-[var(--width-vp-layout)] px-6 md:px-8;
}

html[data-vpress-sub-theme='{{ id }}'] .vpress-{{ id }}-content:not(:has(.VPRichPage--landing)):not(:has(.vpress-grapesjs-frontend)) {
    @apply py-12 md:py-24;
}
